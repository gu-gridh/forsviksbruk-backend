# forsviksbruk Environment Variables
# Copy this file to .env and update the values for your environment.
# Every value can also be set as a real environment variable instead.

# dev (default) or production
DJANGO_ENV=production

# Django Secret Key, required in production. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Hosts and origins (comma-separated)
ALLOWED_HOSTS=your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Set to False if the reverse proxy already redirects http to https
SECURE_SSL_REDIRECT=True

# Database (PostGIS). Leave unset locally to use the local Postgres socket.
# With docker compose, use DB_HOST=db
DB_NAME=forsviksbruk
DB_USER=forsviksbruk_user
DB_PASS=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Media and Static Files
MEDIA_ROOT=/path/to/media
MEDIA_URL=/media/
STATIC_ROOT=/path/to/static
STATIC_URL=/static/

# Digicure viewer
# IIIF server URL of MEDIA_ROOT, e.g. https://img.dh.gu.se/forsviksbruk/media/
IIIF_URL=
# Public URL of MEDIA_ROOT/panorama/, e.g. https://forsviksbruk.dh.gu.se/media/panorama/
PANORAMA_PUBLIC_BASE_URL=
# Set to true to send uploaded panoramas to the image processor
IMAGE_PROCESSOR_ENABLED=false
IMAGE_PROCESSOR_URL=
IMAGE_PROCESSOR_TOKEN=

# Email (production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password
